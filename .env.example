# Sao chép file này thành .env.local khi chạy local:  cp .env.example .env.local
# TUYỆT ĐỐI không điền secret thật vào file này và không commit .env.local.

# --- Database (Neon qua tích hợp Vercel) ---
# Connection string chính mà app dùng (Drizzle / Neon serverless).
DATABASE_URL=
# Nhóm biến POSTGRES_* (POSTGRES_URL, POSTGRES_HOST, POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DATABASE, NEON_PROJECT_ID...) do tích hợp
# Vercel + Neon tự cấp trên Vercel — không cần khai báo tay ở local.
POSTGRES_URL=

# --- Neon Auth (Managed Better Auth) ---
# Base URL của Neon Auth (CHƯA có cho fashion — chờ bật Neon Auth trên branch fashion).
NEON_AUTH_BASE_URL=
# Secret ký cookie phiên đăng nhập (tối thiểu 32 ký tự ngẫu nhiên).
# Sinh bằng: openssl rand -base64 32 — chỉ đặt trên Vercel / .env.local.
NEON_AUTH_COOKIE_SECRET=

# --- Phân quyền Admin (HAP-15) ---
# Danh sách email được vào khu /admin, phân cách bằng dấu phẩy.
# Ví dụ: ADMIN_EMAILS=ten@vidu.com
# Để trống = không có admin nào. Đổi env trên Vercel phải redeploy mới
# có hiệu lực — cách chỉ định admin đầu tiên xem README mục
# "Quản trị viên (admin)".
ADMIN_EMAILS=

# --- VietQR (thông tin nhận tiền CÔNG KHAI, hiển thị ở checkout) ---
# Mã ngân hàng (BIN), số tài khoản và tên chủ tài khoản của shop.
NEXT_PUBLIC_BANK_BIN=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
